      "resolution": "api_predefined",
      "applies_to": "all",
      "score_range": {
        "min": 0,
        "max": 1,
        "type": "rubric",
        "description": "Rubric pass rate (0.0-1.0). Evaluates overall response quality across multiple rubric criteria."
      }
    },

